<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Tgs.Promotion.DepositAccumulateRoulette.Worker</RootNamespace>
    <UserSecretsId>e7ef8328-a199-4f5b-8b54-571e18959fa0</UserSecretsId>
    <GlobalNugetConfig>$(UserProfile)\AppData\Roaming\NuGet\NuGet.Config</GlobalNugetConfig>
    <GlobalNugetConfig Condition="'$(UserProfile)'==''">$(HOME)/.nuget/NuGet/NuGet.Config</GlobalNugetConfig>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerfileBuildArguments>--build-arg "BuildConfiguration=$(Configuration)" --secret id=nuget,src="$(GlobalNugetConfig)"</DockerfileBuildArguments>
    <DockerfileTag Condition="$(DockerfileTag) == ''">deposit-accumulate-roulette-worker</DockerfileTag>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DateOnlyTimeOnly.AspNet" Version="1.0.3" />
    <PackageReference Include="DateOnlyTimeOnly.AspNet.Swashbuckle" Version="1.0.3" />
    <PackageReference Include="FluentdForward.OpenTelemetry.MessagePack" Version="0.2.0" />
    <PackageReference Include="Hangfire.MemoryStorage" Version="1.7.0" />
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.17.0" />
    <PackageReference Include="Npgsql.OpenTelemetry" Version="6.0.7" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.3.1" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.0.0-rc9.5" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.0.0-rc9.5" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.0.0-rc9.5" />
    <PackageReference Include="PhoenixToolkits.Protobuf.ExtendTypes" Version="0.0.6" />
    <PackageReference Include="ProfileViewer.OpenTelemetry.Exporter" Version="0.2.1" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.4.0" />
    <PackageReference Include="Tgs.Interceptors" Version="0.2.1" />
    <PackageReference Include="Tgs.MessageQueue.Nats" Version="2.1.6" />
  </ItemGroup>


  <ItemGroup>
    <ProjectReference Include="..\DepositAccumulateRoulette.Repositories\DepositAccumulateRoulette.Repositories.csproj" />
    <ProjectReference Include="..\DepositAccumulateRoulette.Worker.Cache\DepositAccumulateRoulette.Worker.Cache.csproj" />
    <ProjectReference Include="..\DepositAccumulateRoulette.Worker.Core\DepositAccumulateRoulette.Worker.Core.csproj" />
  </ItemGroup>

</Project>
