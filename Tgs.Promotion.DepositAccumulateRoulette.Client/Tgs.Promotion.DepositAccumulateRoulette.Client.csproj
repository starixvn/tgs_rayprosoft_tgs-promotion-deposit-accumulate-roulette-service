<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Tgs.DepositAccumulateRoulette.Clients</RootNamespace>
    <PackageId>Tgs.DepositAccumulateRoulette.Client</PackageId>
    <Version>0.0.1-alpha</Version>
    <Authors>Raypro</Authors>
    <Product>Tgs.DepositAccumulateRouletteClient</Product>
    <PackageProjectUrl>https://gitlab.com/rayprosoft/tgs-promotion-deposit-accumulate-roulette-service</PackageProjectUrl>
    <RepositoryUrl>https://gitlab.com/rayprosoft/tgs-promotion-deposit-accumulate-roulette-service.git</RepositoryUrl>
    <PackageTags>Tgs Deposit Accumulate Roulette</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.21.5" />
    <PackageReference Include="Grpc.Tools" Version="2.47.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" Version="17.2.32">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="PhoenixToolkits.Protobuf.ExtendTypes" Version="0.0.6" />
    <PackageReference Include="Tgs.MessageQueue.Nats" Version="2.1.6" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="..\Tgs.Promotion.DepositAccumulateRouletteService\Protos\depositaccumulateroulette.proto" Link="Protos\depositaccumulateroulette.proto" GrpcServices="None" Access="Internal" />
  </ItemGroup>

</Project>
