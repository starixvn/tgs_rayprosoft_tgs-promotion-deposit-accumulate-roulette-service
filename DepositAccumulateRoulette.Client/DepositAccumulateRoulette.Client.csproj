<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Tgs.DepositAccumulateRoulette.Clients</RootNamespace>
    <PackageId>Tgs.DepositAccumulateRoulette.Client</PackageId>
    <Version>0.0.7</Version>
    <Authors>Raypro</Authors>
    <Product>Tgs.DepositAccumulateRouletteClient</Product>
    <PackageProjectUrl>https://gitlab.com/rayprosoft/tgs-promotion-deposit-accumulate-roulette-service</PackageProjectUrl>
    <RepositoryUrl>https://gitlab.com/rayprosoft/tgs-promotion-deposit-accumulate-roulette-service.git</RepositoryUrl>
    <PackageTags>Tgs Deposit Accumulate Roulette</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DateOnlyTimeOnly.AspNet" Version="2.1.1" />
    <PackageReference Include="Google.Protobuf" Version="3.24.4" />
    <PackageReference Include="Grpc.Tools" Version="2.59.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Http" Version="7.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="7.0.1" />
    <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" Version="17.7.30">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="PhoenixToolkits.MessageQueue.Nats" Version="1.0.6" />
    <PackageReference Include="PhoenixToolkits.Protobuf.ExtendTypes" Version="0.0.6" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="..\DepositAccumulateRouletteService\Protos\promotion_dar_service.proto" Link="Protos\promotion_dar_service.proto" GrpcServices="None" Access="Internal" />
  </ItemGroup>

</Project>
