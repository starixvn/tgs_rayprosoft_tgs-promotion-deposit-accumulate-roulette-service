<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>ca6eb773-a393-4bec-8f92-7381c7d76a5d</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerfileBuildArguments>--build-arg "BuildConfiguration=$(Configuration)"</DockerfileBuildArguments>
    <DockerfileTag Condition="$(DockerfileTag) == ''">deposit-accumulate-roulette</DockerfileTag>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentdForward.OpenTelemetry.MessagePack" Version="0.1.3" />
    <PackageReference Include="Google.Protobuf" Version="3.21.5" />
    <PackageReference Include="Grpc.Tools" Version="2.47.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.15.1" />
    <PackageReference Include="Npgsql.OpenTelemetry" Version="6.0.6" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.3.0" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.0.0-rc9.5" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.0.0-rc9.5" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.0.0-rc9.5" />
    <PackageReference Include="PhoenixToolkits.Protobuf.ExtendTypes" Version="0.0.6" />
    <PackageReference Include="ProfileViewer.OpenTelemetry.Exporter" Version="0.2.1" />
    <PackageReference Include="StackExchange.Redis" Version="2.6.48" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.4.0" />
    <PackageReference Include="Tgs.Interceptors" Version="0.2.1" />
    <PackageReference Include="Tgs.MessageQueue.Nats" Version="2.1.6" />
    <PackageReference Include="Tgs.PlayerService.Client" Version="0.0.15" />
    <PackageReference Include="Tgs.Promotion.Client" Version="1.0.24-alpha" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tgs.Promotion.DepositAccumulateRoulette.Common\Tgs.Promotion.DepositAccumulateRoulette.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="Protos\depositaccumulateroulette.proto" GrpcServices="None" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="ApplicationServices\" />
  </ItemGroup>


</Project>
